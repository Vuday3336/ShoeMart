# Supabase PostgreSQL connection string
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI) -> "Connection pooling" (Transaction mode, port 6543) is recommended for backend servers
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT secret - use any long random string
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
